# Copy this file to .env and fill in your actual values

# Google Gemini API Key
# Reserved for a later AI integration. Do not add a key until then.
# GOOGLE_API_KEY=

# Database (from docker-compose)
DATABASE_URL="postgresql://resumeiq_user:resumeiq_pass@localhost:5432/resumeiq"

# Redis (from docker-compose)
REDIS_URL="redis://localhost:6379"

# Backend Server
PORT=3000
NODE_ENV=development
# Generate a unique development secret (32+ characters) outside version control.
JWT_SECRET="replace-with-a-local-development-secret-at-least-32-characters"

# Frontend
FRONTEND_URL="http://localhost:3001"
