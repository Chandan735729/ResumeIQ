{
  "name": "resumeiq-backend",
  "version": "0.1.0",
  "description": "ResumeIQ Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "author": "ResumeIQ",
  "license": "MIT",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.8.0",
    "bcryptjs": "2.4.3",
    "docx": "^9.7.1",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "7.1.0",
    "fs-extra": "11.2.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mammoth": "1.8.0",
    "multer": "^1.4.5-lts.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdf-extraction": "^1.0.2",
    "pdf-lib": "1.17.1",
    "pdf-parse": "1.1.1",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "^6.0.227",
    "pdfreader": "^3.0.8",
    "redis": "4.6.12",
    "winston": "3.11.0",
    "zod": "3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.4",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "29.5.8",
    "@types/jsonwebtoken": "9.0.5",
    "@types/jszip": "^3.4.0",
    "@types/multer": "1.4.11",
    "@types/node": "20.10.6",
    "@types/passport-jwt": "3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "eslint": "8.56.0",
    "jest": "29.7.0",
    "pdfkit": "^0.18.0",
    "prisma": "5.8.0",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3"
  }
}
