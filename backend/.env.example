# Database Configuration
DATABASE_URL="postgresql://resumeiq_user:resumeiq_pass@localhost:5432/resumeiq"
REDIS_URL="redis://localhost:6379"

# Server Configuration
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# JWT Configuration
JWT_SECRET="replace-with-a-local-development-secret-at-least-32-characters"
JWT_EXPIRY="24h"

# Google Gemini AI Configuration
GOOGLE_API_KEY="your-google-api-key-here"
GOOGLE_PROJECT_ID="your-google-project-id"
GEMINI_MODEL="gemini-pro"

# AWS S3 Configuration (for storing resume files)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="resumeiq-resumes"

# Logging
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for future use)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
